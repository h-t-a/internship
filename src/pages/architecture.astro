---
import Layout from '../layouts/Layout.astro';
import { dependencyDetails, programArtifacts } from '../data/internshipData.js';
---

<Layout title="System Architecture & Libraries | SDD Digital Banking" currentPath="/architecture">
  <div class="container">
    <!-- Header -->
    <div style="padding-top: 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1.5rem;">
      <div class="hero-tag">
        <span>Architecture & Internal Libraries</span>
      </div>
      <h1 class="hero-title" style="margin-bottom: 0.35rem;">
        Banking Architecture & Core Libraries
      </h1>
      <p class="hero-subtitle" style="margin-bottom: 1rem;">
        Technical blueprint of the dual-portal microservices infrastructure, serverless Azure Functions execution pipeline, and shared libraries (<code class="code-pill">httputils</code> and <code class="code-pill">sequelize-java</code>).
      </p>

      <!-- Quick Section Jump Navigation -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;" class="no-print">
        <a href="#topology" class="btn btn-secondary btn-sm">1. Enterprise Topology</a>
        <a href="#adminconsole-overview" class="btn btn-secondary btn-sm">2. Admin Console Deep Dive</a>
        <a href="#rest-api-comparison" class="btn btn-secondary btn-sm">3. REST API: Serverless vs. Tomcat</a>
        <a href="#dependencies" class="btn btn-secondary btn-sm">4. Shared Libraries</a>
      </div>
    </div>

    <!-- Section 1: Architecture Topology -->
    <section id="topology" class="card" style="padding: 1.5rem; margin-bottom: 2.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.5rem;">
        <div>
          <span class="badge badge-neutral" style="font-size: 0.65rem; margin-bottom: 0.25rem;">SECTION 1</span>
          <h2 style="font-size: 1.125rem; font-weight: 600; color: var(--text-primary);">
            Enterprise Architecture Topology
          </h2>
        </div>
        <span class="badge badge-neutral">4-Tier System</span>
      </div>

      <!-- Diagram Stack -->
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <!-- Tier 1: Client Layer -->
        <div style="border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1.25rem; background: var(--bg-subtle);">
          <span style="font-size: 0.6875rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 0.75rem;">
            Tier 1 — Client Access Layer (Frontend SPAs)
          </span>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.75rem;">
            <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 1rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                <strong style="color: var(--text-primary); font-size: 0.875rem;">iBanking Portal (Customer)</strong>
                <span class="badge badge-neutral">Angular 17+</span>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4;">
                Public-facing retail banking. OTP authentication, JWT access tokens, account balances, transfers, and statement exports.
              </p>
              <div style="margin-top: 0.5rem; display: flex; gap: 0.35rem; flex-wrap: wrap;">
                <span class="code-pill">iBanking_repo/ibanking-spa</span>
                <span class="code-pill">iBanking_repo/ibanking17</span>
              </div>
            </div>

            <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 1rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                <strong style="color: var(--text-primary); font-size: 0.875rem;">Admin Console (Back-Office)</strong>
                <span class="badge badge-neutral">Angular SPA</span>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4;">
                Internal staff only. RBAC permissions, Maker-Checker workflows, user lock/unlock, and audit trail viewers.
              </p>
              <div style="margin-top: 0.5rem; display: flex; gap: 0.35rem; flex-wrap: wrap;">
                <span class="code-pill">adminConsole_repo/admin_console_spa</span>
                <span class="code-pill">adminConsole_repo/admin_console</span>
              </div>
            </div>
          </div>
        </div>

        <div style="text-align: center; color: var(--text-muted); font-size: 0.8125rem; font-family: var(--font-mono);">
          &darr; HTTPS / TLS 1.3 Request Flow
        </div>

        <!-- Tier 2: Gateway Layer -->
        <div style="border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1.25rem; background: var(--bg-subtle);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span style="font-size: 0.6875rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.05em;">
              Tier 2 — API Gateway & Reverse Proxy Layer
            </span>
            <span class="code-pill">API Gateway Routing</span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; font-size: 0.75rem;">
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: var(--radius-xs); border: 1px solid var(--border-subtle);">
              <strong style="color: var(--text-primary); display: block; margin-bottom: 0.2rem;">URL Routing:</strong>
              <span style="color: var(--text-muted);">/api/v1/customer/* &rarr; iBanking</span><br/>
              <span style="color: var(--text-muted);">/api/v1/admin/* &rarr; Admin Console</span>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: var(--radius-xs); border: 1px solid var(--border-subtle);">
              <strong style="color: var(--text-primary); display: block; margin-bottom: 0.2rem;">Security Guard:</strong>
              <span style="color: var(--text-muted);">Token verification, rate limiting, and header sanitization.</span>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: var(--radius-xs); border: 1px solid var(--border-subtle);">
              <strong style="color: var(--text-primary); display: block; margin-bottom: 0.2rem;">Correlation Tracing:</strong>
              <span style="color: var(--text-muted);">X-Correlation-ID injection across all downstream requests.</span>
            </div>
          </div>
        </div>

        <div style="text-align: center; color: var(--text-muted); font-size: 0.8125rem; font-family: var(--font-mono);">
          &darr; Internal Network
        </div>

        <!-- Tier 3: Serverless Backend Layer -->
        <div style="border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1.25rem; background: var(--bg-subtle);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span style="font-size: 0.6875rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.05em;">
              Tier 3 — Serverless Services (Azure Functions + Java 17)
            </span>
            <span class="code-pill">host.json</span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.75rem;">
            <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 0.85rem;">
              <strong style="color: var(--text-primary); font-size: 0.8125rem; display: block; margin-bottom: 0.35rem;">Serverless Microservices</strong>
              <ul style="list-style: none; font-size: 0.75rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.25rem;">
                <li>&bull; <code class="code-pill">admin_console</code>: Administrative endpoints & RBAC</li>
                <li>&bull; <code class="code-pill">ibanking17</code>: Customer financial operations</li>
              </ul>
            </div>

            <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 0.85rem;">
              <strong style="color: var(--text-primary); font-size: 0.8125rem; display: block; margin-bottom: 0.35rem;">Embedded Dependencies</strong>
              <ul style="list-style: none; font-size: 0.75rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.25rem;">
                <li>&bull; <code class="code-pill">httputils</code>: Standardized outbound HTTP client</li>
                <li>&bull; <code class="code-pill">sequelize-java</code>: Lightweight SQL query builder</li>
              </ul>
            </div>
          </div>
        </div>

        <div style="text-align: center; color: var(--text-muted); font-size: 0.8125rem; font-family: var(--font-mono);">
          &darr; JDBC Connection Pool
        </div>

        <!-- Tier 4: Database Layer -->
        <div id="persistence" style="border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1.25rem; background: var(--bg-subtle);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.6875rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.05em;">
              Tier 4 — Persistence & Audit Store (PostgreSQL `adminchannel` & MSSQL)
            </span>
            <div style="display: flex; gap: 0.35rem;">
              <a href={programArtifacts.assets.dbDumpZip} download class="btn btn-outline btn-sm" style="font-size: 0.6875rem; padding: 0.2rem 0.5rem;">
                Download Dump .zip ({programArtifacts.assets.dbDumpZipSize})
              </a>
              <a href={programArtifacts.assets.dbDump} download class="btn btn-outline btn-sm" style="font-size: 0.6875rem; padding: 0.2rem 0.5rem;">
                Raw .dump ({programArtifacts.assets.dbDumpSize})
              </a>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; font-size: 0.75rem; margin-bottom: 1rem;">
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: var(--radius-xs); border: 1px solid var(--border-subtle);">
              <strong style="color: var(--text-primary); display: block; margin-bottom: 0.2rem;">PostgreSQL Schema</strong>
              <code class="code-pill">adminchannel</code>
              <p style="color: var(--text-secondary); margin-top: 0.35rem;">
                30+ tables restored during Week 1 Day 5 onboarding into target database <code class="code-pill">cleandb</code>.
              </p>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: var(--radius-xs); border: 1px solid var(--border-subtle);">
              <strong style="color: var(--text-primary); display: block; margin-bottom: 0.2rem;">Admin RBAC & Tokens</strong>
              <div style="display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.35rem;">
                <code class="code-pill">admin_user</code>
                <code class="code-pill">roles</code>
                <code class="code-pill">blacklisttoken</code>
              </div>
              <p style="color: var(--text-secondary); margin-top: 0.35rem;">Admin identities, role mappings, and JWT blacklisting.</p>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: var(--radius-xs); border: 1px solid var(--border-subtle);">
              <strong style="color: var(--text-primary); display: block; margin-bottom: 0.2rem;">Banking Core Tables</strong>
              <div style="display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.35rem;">
                <code class="code-pill">accountmapping</code>
                <code class="code-pill">branchsetting</code>
                <code class="code-pill">atmsequence</code>
              </div>
              <p style="color: var(--text-secondary); margin-top: 0.35rem;">Branch configurations, CIF mappings, and cheque records.</p>
            </div>
          </div>

          <!-- Restoration Command Snippet -->
          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 0.75rem;">
            <div style="font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem;">
              Database Restoration Command (PgAdmin4 / CLI)
            </div>
            <code style="font-size: 0.6875rem; font-family: var(--font-mono); color: var(--text-secondary); display: block; line-height: 1.5;">
              # 1. Create database in PostgreSQL<br/>
              createdb -U postgres cleandb<br/>
              # 2. Restore schema dump from assets directory<br/>
              pg_restore -U postgres -d cleandb -v assets/adminconsole.dump
            </code>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Comprehensive Overview: The Admin Console Project -->
    <section id="adminconsole-overview" class="card" style="padding: 1.75rem; margin-bottom: 2.5rem; border-left: 3px solid var(--accent-blue);">
      <div style="margin-bottom: 1.25rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
          <span class="badge badge-warning" style="font-size: 0.6875rem;">SECTION 2 &bull; DEEP DIVE</span>
          <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">adminConsole_repo</span>
        </div>
        <h2 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary);">
          Comprehensive Overview: The Admin Console Project (<code class="code-pill">adminconsole</code>)
        </h2>
        <p style="color: var(--text-secondary); font-size: 0.8125rem; margin-top: 0.25rem;">
          What is it for? Who uses it? Where does it run? Why is it needed? And what core problems does it resolve?
        </p>
      </div>

      <!-- 1. The Big Picture Analogy -->
      <div style="background: var(--bg-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1.25rem; margin-bottom: 1.5rem;">
        <span style="font-size: 0.6875rem; text-transform: uppercase; color: var(--accent-blue); font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 0.5rem;">
          1. The Big Picture Analogy
        </span>
        <div style="font-size: 0.875rem; color: var(--text-primary); line-height: 1.6;">
          <p style="margin-bottom: 0.5rem;">
            <strong>Think of a bank like a physical branch:</strong>
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.4rem; padding-left: 0.5rem;">
            <li>
              &bull; <strong style="color: var(--text-primary);"><code>iBanking_portal</code> is the Front Counter / ATM:</strong> Designed for retail banking customers to check balances, transfer funds, pay utility bills, and view statements on their phones or laptops.
            </li>
            <li>
              &bull; <strong style="color: var(--text-primary);"><code>adminconsole</code> is the Bank's Back-Office &amp; Vault Control Room:</strong> The internal operational cockpit used exclusively by bank staff to manage banking rules, review customer requests, adjust limits, prevent fraud, and audit operations.
            </li>
          </ul>
          <p style="margin-top: 0.75rem; font-size: 0.8125rem; color: var(--text-secondary); border-top: 1px solid var(--border-subtle); padding-top: 0.5rem; margin-bottom: 0;">
            <em>Rule: Customers must <strong>never</strong> have access to back-office controls. The Admin Console is the dedicated software that keeps the bank operational, compliant, and secure behind the scenes.</em>
          </p>
        </div>
      </div>

      <!-- 2. Who Is It For? (Target Personas) -->
      <div style="margin-bottom: 1.5rem;">
        <span style="font-size: 0.6875rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 0.75rem;">
          2. Who Is It For? (Target Personas &amp; RBAC Governance)
        </span>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.8125rem; text-align: left;">
            <thead>
              <tr style="background: var(--bg-subtle); border-bottom: 1px solid var(--border-subtle);">
                <th style="padding: 0.6rem 0.75rem; font-weight: 600; color: var(--text-primary);">Persona</th>
                <th style="padding: 0.6rem 0.75rem; font-weight: 600; color: var(--text-primary);">Role in the Bank</th>
                <th style="padding: 0.6rem 0.75rem; font-weight: 600; color: var(--text-primary);">What They Do in the Admin Console</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.6rem 0.75rem; font-weight: 600; color: var(--text-primary); white-space: nowrap;">Bank Operators / Makers</td>
                <td style="padding: 0.6rem 0.75rem; color: var(--text-secondary);">Branch staff, customer service officers</td>
                <td style="padding: 0.6rem 0.75rem; color: var(--text-secondary);">Enter CIF customer-to-account mappings, process chequebook requests, initiate account unlocks when a customer forgets their password.</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.6rem 0.75rem; font-weight: 600; color: var(--text-primary); white-space: nowrap;">Supervisors / Checkers</td>
                <td style="padding: 0.6rem 0.75rem; color: var(--text-secondary);">Branch managers, senior risk officers</td>
                <td style="padding: 0.6rem 0.75rem; color: var(--text-secondary);"><strong>Maker-Checker Dual Control:</strong> Review and approve or reject sensitive actions initiated by Makers (e.g., limit overrides, large adjustments).</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.6rem 0.75rem; font-weight: 600; color: var(--text-primary); white-space: nowrap;">System Administrators</td>
                <td style="padding: 0.6rem 0.75rem; color: var(--text-secondary);">Bank IT operations team</td>
                <td style="padding: 0.6rem 0.75rem; color: var(--text-secondary);">Provision staff accounts (<code class="code-pill">admin_user</code>), assign roles (<code class="code-pill">roles</code>, <code class="code-pill">permissions</code>), set password policies, and revoke compromised sessions (<code class="code-pill">blacklisttoken</code>).</td>
              </tr>
              <tr>
                <td style="padding: 0.6rem 0.75rem; font-weight: 600; color: var(--text-primary); white-space: nowrap;">Compliance &amp; Audit Officers</td>
                <td style="padding: 0.6rem 0.75rem; color: var(--text-secondary);">Internal audit, regulatory compliance</td>
                <td style="padding: 0.6rem 0.75rem; color: var(--text-secondary);">Inspect immutable audit trails (<em>Who, What, When, IP address, Old Value vs New Value</em>) to satisfy Central Bank regulations.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 3. Where Is It Used? -->
      <div style="margin-bottom: 1.5rem;">
        <span style="font-size: 0.6875rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 0.75rem;">
          3. Where Is It Used? (Operational Context)
        </span>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.75rem;">
          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 1rem;">
            <strong style="color: var(--text-primary); font-size: 0.8125rem; display: block; margin-bottom: 0.25rem;">Operational Environment</strong>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.45; margin: 0;">
              Run exclusively on the bank’s internal corporate intranet and secure branch workstations. It is never exposed as a public-facing signup portal.
            </p>
          </div>
          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 1rem;">
            <strong style="color: var(--text-primary); font-size: 0.8125rem; display: block; margin-bottom: 0.25rem;">Technical Architecture</strong>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.45; margin: 0;">
              An Angular SPA (<code class="code-pill">admin_console_spa</code>) communicating with serverless Java backend microservices (<code class="code-pill">admin_console</code>) over PostgreSQL (<code class="code-pill">cleandb</code>, schema <code class="code-pill">adminchannel</code>).
            </p>
          </div>
        </div>
      </div>

      <!-- 4. Why Is This Project Needed? (Problems Solved) -->
      <div style="margin-bottom: 1.5rem;">
        <span style="font-size: 0.6875rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 0.75rem;">
          4. Why Is This Project Needed? (Core Problems Solved)
        </span>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.75rem;">
          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 1rem;">
            <span class="badge badge-neutral" style="font-size: 0.65rem; margin-bottom: 0.25rem;">Problem 1</span>
            <strong style="color: var(--text-primary); font-size: 0.8125rem; display: block; margin-bottom: 0.25rem;">Segregation of Duties (Dual Control)</strong>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4; margin: 0;">
              In banking, an operator cannot change balances or limits unilaterally. The Admin Console enforces <strong>Maker-Checker workflows</strong> where sensitive operations require independent supervisor approval.
            </p>
          </div>

          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 1rem;">
            <span class="badge badge-neutral" style="font-size: 0.65rem; margin-bottom: 0.25rem;">Problem 2</span>
            <strong style="color: var(--text-primary); font-size: 0.8125rem; display: block; margin-bottom: 0.25rem;">Dynamic Banking Operations</strong>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4; margin: 0;">
              Banks change limits, commission rates, and bill upload merchants regularly. Instead of redeploying code, staff update configurations on the fly via administrative screens.
            </p>
          </div>

          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 1rem;">
            <span class="badge badge-neutral" style="font-size: 0.65rem; margin-bottom: 0.25rem;">Problem 3</span>
            <strong style="color: var(--text-primary); font-size: 0.8125rem; display: block; margin-bottom: 0.25rem;">Customer Support &amp; Disputes</strong>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4; margin: 0;">
              When accounts lock after 3 bad passwords or an OTP fails, staff use <code class="code-pill">otp-list</code> and <code class="code-pill">user-setup</code> to diagnose and resolve customer issues safely.
            </p>
          </div>

          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); padding: 1rem;">
            <span class="badge badge-neutral" style="font-size: 0.65rem; margin-bottom: 0.25rem;">Problem 4</span>
            <strong style="color: var(--text-primary); font-size: 0.8125rem; display: block; margin-bottom: 0.25rem;">Regulatory Compliance &amp; Auditing</strong>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4; margin: 0;">
              Central Bank regulations mandate immutable audit records. The Admin Console records actor ID, timestamp, IP, and data deltas for every mutation.
            </p>
          </div>
        </div>
      </div>

      <!-- 5. Key Functional Modules in the Codebase -->
      <div style="margin-bottom: 1.5rem;">
        <span style="font-size: 0.6875rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 0.75rem;">
          5. Key Functional Modules (Mapping to Codebase: <code>projects/ibanking-admin/src/app</code>)
        </span>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.75rem;">
