  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const sliders = document.querySelectorAll('.metric-slider');
      const overallGrade = document.getElementById('overall-grade');
      const gradeBadge = document.getElementById('grade-badge');
      const feedback = document.getElementById('mgr-feedback');
      const saveBtn = document.getElementById('save-mgr-notes');
      const statusBadge = document.getElementById('mgr-notes-status');

      function calculateGrade() {
        let total = 0;
        sliders.forEach(slider => {
          const weight = parseFloat(slider.getAttribute('data-weight')) / 100;
          const val = parseFloat(slider.value);
          const idx = slider.getAttribute('data-index');
          const disp = document.getElementById(`score-val-${idx}`);
          if (disp) disp.textContent = `${val}%`;
          total += (val * weight);
        });

        if (overallGrade) {
          overallGrade.textContent = `${total.toFixed(1)}%`;
        }

        if (gradeBadge) {
          if (total >= 90) {
            gradeBadge.textContent = 'Grade: Outstanding (A)';
            gradeBadge.className = 'badge badge-success';
          } else if (total >= 80) {
            gradeBadge.textContent = 'Grade: Exceeds (B+)';
            gradeBadge.className = 'badge badge-neutral';
          } else if (total >= 70) {
            gradeBadge.textContent = 'Grade: Satisfactory (B)';
            gradeBadge.className = 'badge badge-warning';
          } else {
            gradeBadge.textContent = 'Grade: Needs Improvement';
            gradeBadge.className = 'badge badge-rose';
          }
        }
      }

      sliders.forEach(s => s.addEventListener('input', calculateGrade));
      calculateGrade();

      const savedNotes = localStorage.getItem('manager_feedback_notes');
      if (savedNotes && feedback) {
        feedback.value = savedNotes;
      }

      if (saveBtn && feedback) {
        saveBtn.addEventListener('click', () => {
          localStorage.setItem('manager_feedback_notes', feedback.value);
          if (statusBadge) {
            statusBadge.textContent = 'Saved!';
            setTimeout(() => { statusBadge.textContent = 'Notes Saved'; }, 2000);
          }
        });
      }

      // Week 5 Day 1 Checklist counter & localStorage
      const w5Checks = document.querySelectorAll('.mgr-w5-check');
      const w5Counter = document.getElementById('mgr-w5-check-counter');
      const W5_KEY = 'mgr_w5_d1_checks';

      function updateW5Checks() {
        let count = 0;
        const state = {};
        w5Checks.forEach(cb => {
          state[cb.getAttribute('data-key')] = cb.checked;
          if (cb.checked) count++;
        });
        if (w5Counter) {
          w5Counter.textContent = `${count} / ${w5Checks.length} Verified`;
          w5Counter.className = count === w5Checks.length ? 'badge badge-success' : 'badge badge-warning';
        }
        localStorage.setItem(W5_KEY, JSON.stringify(state));
      }

      const savedW5 = localStorage.getItem(W5_KEY);
      if (savedW5) {
        try {
          const parsed = JSON.parse(savedW5);
          w5Checks.forEach(cb => {
            const k = cb.getAttribute('data-key');
            if (parsed[k] !== undefined) cb.checked = parsed[k];
          });
        } catch (e) {}
      }
      updateW5Checks();
      w5Checks.forEach(cb => cb.addEventListener('change', updateW5Checks));

      // Copy Chat Group Reply button
      const copyChatBtn = document.getElementById('mgr-copy-w5-chat');
      const chatText = document.getElementById('mgr-w5-chat-text');
      if (copyChatBtn && chatText) {
        copyChatBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(chatText.value);
          const orig = copyChatBtn.innerHTML;
          copyChatBtn.innerHTML = '<span>&#10003; Copied!</span>';
          setTimeout(() => { copyChatBtn.innerHTML = orig; }, 2000);
        });
      }
    });
  </script>
</Layout>
