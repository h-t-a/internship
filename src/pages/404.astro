---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | SDD Digital Banking" currentPath="/404">
  <div class="container" style="text-align: center; padding: 6rem 1rem 4rem;">
    <div style="font-size: 4rem; font-weight: 700; color: var(--text-muted); font-family: var(--font-mono); line-height: 1; margin-bottom: 1rem;">404</div>
    <h1 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-primary);">Milestone or Report Not Found</h1>
    <p style="color: var(--text-secondary); max-width: 480px; margin: 0 auto 1.75rem; font-size: 0.875rem;">
      The requested route does not exist in the 2026 Digital Banking Internship portal.
    </p>
    <a href="/" class="btn btn-primary">
      &larr; Return to Dashboard
    </a>
  </div>
</Layout>
