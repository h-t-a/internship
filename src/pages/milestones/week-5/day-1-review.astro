  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Checklist persistence
      const STORAGE_KEY = 'sdd_w5d1_reviewer_checks_v1';
      const checkboxes = document.querySelectorAll('.w5d1-check');
      const progressBadge = document.getElementById('w5d1-checklist-progress');
      const resetBtn = document.getElementById('w5d1-reset-checks');

      function updateProgress() {
        let checkedCount = 0;
        const state = {};
        checkboxes.forEach(cb => {
          const id = cb.getAttribute('data-id');
          state[id] = cb.checked;
          if (cb.checked) checkedCount++;
        });
        if (progressBadge) {
          progressBadge.textContent = `${checkedCount} / ${checkboxes.length} Checked`;
          progressBadge.className = checkedCount === checkboxes.length ? 'badge badge-success' : 'badge badge-warning';
        }
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      }

      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          checkboxes.forEach(cb => {
            const id = cb.getAttribute('data-id');
            if (parsed[id] !== undefined) cb.checked = parsed[id];
          });
        } catch (e) {}
      } else {
        // Default: check the items verified during review
        checkboxes.forEach(cb => { cb.checked = true; });
      }
      updateProgress();

      checkboxes.forEach(cb => cb.addEventListener('change', updateProgress));

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          checkboxes.forEach(cb => { cb.checked = false; });
          updateProgress();
        });
      }

      // 2. Tab switcher for Phyo vs Yamin
      const tabBtns = document.querySelectorAll('.w5-tab-btn');
      const tabPanels = document.querySelectorAll('.w5-tab-panel');
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          tabBtns.forEach(b => {
            b.classList.remove('btn-primary', 'active');
            b.classList.add('btn-secondary');
          });
          btn.classList.remove('btn-secondary');
          btn.classList.add('btn-primary', 'active');
          tabPanels.forEach(panel => {
            panel.style.display = panel.id === targetId ? 'block' : 'none';
          });
        });
      });

      // 3. Copy Chat Feedback button
      const copyBtn = document.getElementById('copy-chat-feedback-btn');
      const feedbackArea = document.getElementById('chat-feedback-textarea');
      if (copyBtn && feedbackArea) {
        copyBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(feedbackArea.value);
          const original = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span>&#10003; Copied to Clipboard!</span>';
          setTimeout(() => { copyBtn.innerHTML = original; }, 2000);
        });
      }
    });
  </script>
