  <style>
    @media print {
      /* Page setup: A4 Portrait with standard professional margins */
      @page {
        margin: 1.2cm 1cm;
        size: A4 portrait;
      }

      /* Clean page background & text */
      body {
        background: #ffffff !important;
        color: #0f172a !important;
      }

      /* Structural Major Section Page Breaks for Clean PDF Reading */
      section#transition-matrix,
      section#erd,
      .ddl-schema-section,
      .ddl-seed-section,
      section#topology,
      .flow-card,
      section#codebase-integration,
      .backend-section,
      .student-function-section,
      .frontend-section,
      section#checklist,
      section#run-local {
        break-before: page !important;
        page-break-before: always !important;
      }

      /* Heading protection: NEVER orphan headings or card titles */
      h1, h2, h3, h4,
      .section-header,
      .code-card-header,
      strong {
        break-after: avoid !important;
        page-break-after: avoid !important;
      }

      /* Outer section cards allow content to flow cleanly across multiple pages */
      section.card.allow-page-break {
        break-inside: auto !important;
        page-break-inside: auto !important;
        margin-bottom: 1.5rem !important;
        box-shadow: none !important;
      }

      /* Responsive Grids: Stacks into clean vertical cards in print without clipping */
      div[style*="grid-template-columns"] {
        display: block !important;
      }

      /* Atomic Cards: NEVER slice an individual code block, DDL, or diagram across pages */
      .code-card,
      .ddl-subcard,
      .flow-card,
      .topology-card,
      .tree-card,
      .lab-card,
      .run-local-card,
      .mermaid-diagram-container {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
        margin-bottom: 1.25rem !important;
        background: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        box-shadow: none !important;
        width: 100% !important;
      }

      /* End-to-End Client-Server Topology Print Scaling: fits crisp on A4 with Section 4 Header */
      .topology-card pre {
        font-size: 0.52rem !important;
        line-height: 1.18 !important;
        padding: 0.5rem !important;
      }

      /* Clean code box font sizing & formatting for crisp A4 printable fit */
      .ddl-box,
      .code-box,
      pre {
        background: #f8fafc !important;
        color: #0f172a !important;
        border: 1px solid #cbd5e1 !important;
        max-height: none !important;
        height: auto !important;
        overflow: visible !important;
        overflow-x: visible !important;
        overflow-y: visible !important;
        white-space: pre-wrap !important;
        word-break: break-word !important;
        scrollbar-width: none !important;
        font-size: 0.65rem !important;
        line-height: 1.32 !important;
        padding: 0.65rem !important;
        border-radius: 4px !important;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
      }

      /* Eliminate nested double borders for pre inside code boxes */
      .code-box pre,
      .ddl-box pre {
        border: none !important;
        padding: 0 !important;
        background: transparent !important;
        margin: 0 !important;
      }

      /* Card header styling in print */
      .code-card-header {
        background: #f1f5f9 !important;
        border-bottom: 1px solid #cbd5e1 !important;
        padding: 0.5rem 0.75rem !important;
        break-after: avoid !important;
        page-break-after: avoid !important;
      }

      /* Mermaid Diagrams */
      .mermaid-diagram-container {
        overflow: visible !important;
        max-width: 100% !important;
        background: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        padding: 0.75rem !important;
      }
      .mermaid-diagram-container svg {
        max-width: 100% !important;
        height: auto !important;
      }

      /* Table formatting in print */
      table {
        border-collapse: collapse !important;
        width: 100% !important;
      }
      tr {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
      }
      th, td {
        padding: 0.5rem 0.65rem !important;
        font-size: 0.75rem !important;
      }

      /* Hide interactive & non-printable elements */
      .no-print, .btn, button, nav, .site-header, .site-footer {
        display: none !important;
      }

      ::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }
    }
  </style>

  <script is:inline>
    function copyDdlScript() {
      const codeEl = document.getElementById('ddl-script-content');
      if (!codeEl) return;
      navigator.clipboard.writeText(codeEl.innerText).then(() => {
        const btn = document.getElementById('copy-ddl-btn');
        if (btn) {
          const originalHtml = btn.innerHTML;
          btn.innerHTML = '<span style="color: var(--accent-green, #10b981);">✓ Copied to Clipboard!</span>';
          setTimeout(() => {
            btn.innerHTML = originalHtml;
          }, 2500);
        }
      });
    }

    function copyCodeBlock(elementId, btn) {
      const codeEl = document.getElementById(elementId);
      if (!codeEl) return;
      navigator.clipboard.writeText(codeEl.innerText).then(() => {
        if (btn) {
          const originalHtml = btn.innerHTML;
          btn.innerHTML = '<span style="color: var(--accent-green, #10b981);">✓ Copied!</span>';
          setTimeout(() => {
            btn.innerHTML = originalHtml;
          }, 2000);
        }
      });
    }
  </script>

  <!-- Mermaid.js initialization for sequence diagrams -->
  <script is:inline type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ 
      startOnLoad: true,
      theme: 'neutral',
      fontFamily: 'Inter, sans-serif',
      sequence: {
        mirrorActors: false,
        bottomMarginAdj: 10
      }
    });
  </script>
