<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Interactive checkboxes
    document.querySelectorAll('.checklist-item').forEach(item => {
      item.style.cursor = 'pointer';
      item.addEventListener('click', () => {
        const box = item.querySelector('.custom-checkbox');
        if (box) {
          box.classList.toggle('checked');
          if (box.classList.contains('checked')) {
            box.style.background = 'var(--accent-blue)';
            box.style.borderColor = 'var(--accent-blue)';
            box.innerHTML = '&#10003;';
            box.style.color = '#ffffff';
            box.style.display = 'flex';
            box.style.alignItems = 'center';
            box.style.justifyContent = 'center';
            box.style.fontSize = '10px';
          } else {
            box.style.background = 'transparent';
            box.style.borderColor = 'var(--border-subtle)';
            box.innerHTML = '';
          }
        }
      });
    });

    // Mentor scorecard calculation
    const sliders = document.querySelectorAll('.mentor-slider');
    const totalScoreEl = document.getElementById('mentor-total-score');
    const statusBadgeEl = document.getElementById('mentor-status-badge');
    const saveBtn = document.getElementById('save-mentor-rubric-btn');

    function calculateMentorTotal() {
      let total = 0;
      sliders.forEach(slider => {
        const cat = slider.getAttribute('data-cat');
        const val = parseInt(slider.value) || 0;
        const max = parseInt(slider.getAttribute('max')) || 20;
        const valSpan = document.getElementById(`score-cat-${cat}-val`);
        if (valSpan) {
          valSpan.textContent = `${val} / ${max}`;
        }
        total += val;
      });

      if (totalScoreEl) {
        totalScoreEl.textContent = `${total} / 100`;
      }

      if (statusBadgeEl) {
        if (total >= 75) {
          statusBadgeEl.className = 'badge badge-success';
          statusBadgeEl.textContent = `Status: Passed (${total}%)`;
        } else {
          statusBadgeEl.className = 'badge badge-warning';
          statusBadgeEl.textContent = `Status: Needs Revision (${total}%)`;
        }
      }
    }

    sliders.forEach(slider => {
      slider.addEventListener('input', calculateMentorTotal);
    });

    // Restore saved score from localStorage
    const savedScores = localStorage.getItem('mentor_practice_scores_w2');
    if (savedScores) {
      try {
        const parsed = JSON.parse(savedScores);
        sliders.forEach(slider => {
          const cat = slider.getAttribute('data-cat');
          if (parsed[cat] !== undefined) {
            slider.value = parsed[cat];
          }
        });
        calculateMentorTotal();
      } catch (e) {}
    }

    if (saveBtn) {
      saveBtn.addEventListener('click', () => {
        const scores = {};
        sliders.forEach(slider => {
          scores[slider.getAttribute('data-cat')] = slider.value;
        });
        localStorage.setItem('mentor_practice_scores_w2', JSON.stringify(scores));
        saveBtn.textContent = '✓ Marks Saved Locally!';
        setTimeout(() => {
          saveBtn.textContent = 'Save Marks Locally';
        }, 2000);
      });
    }
  });
</script>
