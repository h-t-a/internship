---
import Layout from '../../layouts/Layout.astro';
import { visibleWeeksData, visibleMonthsData, roadmapConfig, weeksData, monthsData } from '../../data/internshipData.js';
---

<Layout title="Curriculum Roadmap | SDD Digital Banking Internship" currentPath="/milestones">
  <div class="container">
    <div style="padding-top: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1.5rem;">
      <div class="hero-tag">
        <span>Curriculum & Milestones</span>
      </div>
      <h1 class="hero-title" style="margin-bottom: 0.35rem;">
        Active Milestones & Curriculum Roadmap
      </h1>
      <p class="hero-subtitle" style="margin-bottom: 0;">
        Active sprint: Weeks 1 to {roadmapConfig.maxVisibleWeek ?? 2}. Later weeks and months are hidden and can be unlocked via <code class="code-pill">roadmapConfig</code>.
      </p>
    </div>

    <!-- Filter & Search Controls -->
    <div class="card" style="padding: 1rem 1.25rem; margin-bottom: 2rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">
      <div style="display: flex; gap: 0.375rem; flex-wrap: wrap;" id="filter-buttons">
        <button class="btn btn-primary btn-sm filter-btn active" data-filter="all">All Visible Weeks</button>
        {visibleMonthsData.map((m) => (
          <button class="btn btn-secondary btn-sm filter-btn" data-filter={`month-${m.month}`}>Month {m.month}</button>
        ))}
      </div>

      <div style="position: relative; min-width: 260px; width: 100%; max-width: 320px;">
        <input
          type="text"
          id="milestone-search"
          placeholder="Filter active topics..."
          style="width: 100%; padding: 0.45rem 0.85rem 0.45rem 2.15rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-xs); color: var(--text-primary); font-family: inherit; font-size: 0.8125rem;"
        />
        <svg style="position: absolute; left: 0.65rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
    </div>

    <!-- Weeks List Grid -->
    <div id="weeks-container" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
      {visibleWeeksData.map((week) => (
        <div
          class="card week-card"
          data-month={`month-${week.month}`}
          data-status={week.status.toLowerCase().replace(' ', '-')}
          data-text={`${week.title} ${week.summary} ${week.objectives.join(' ')}`.toLowerCase()}
          style={`padding: 1.5rem; border-left: 3px solid ${week.status === 'Completed' ? 'var(--accent-emerald)' : week.status === 'In Progress' ? 'var(--accent-amber)' : 'var(--border-subtle)'};`}
        >
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.75rem;">
            <div>
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                <span class="badge badge-neutral" style="font-family: var(--font-mono); font-size: 0.65rem;">WEEK {week.week}</span>
                <span class="badge badge-neutral" style="font-size: 0.65rem;">MONTH {week.month}</span>
                <span class={`badge ${week.status === 'Completed' ? 'badge-success' : week.status === 'In Progress' ? 'badge-warning' : 'badge-neutral'}`}>
                  {week.status}
                </span>
                <span style="color: var(--text-muted); font-size: 0.75rem; font-family: var(--font-mono);">
                  {week.period}
                </span>
              </div>
              <h2 style="font-size: 1.125rem; font-weight: 600; color: var(--text-primary);">
                {week.title}
              </h2>
            </div>

            <div style="display: flex; gap: 0.375rem; align-items: center; flex-wrap: wrap;">
              {week.hasDetailPlan && (
                <a href={`/milestones/${week.planSlug}`} class="btn btn-primary btn-sm">
                  <span>Detailed Plan</span>
                  &rarr;
                </a>
              )}
              {week.week === 1 ? (
                <a href="/reports/week-1" class="btn btn-secondary btn-sm">
                  <span>Report #1</span>
                </a>
              ) : (
                <a href={`/reports/new?week=${week.week}`} class="btn btn-outline btn-sm">
                  <span>Report</span>
                </a>
              )}
            </div>
          </div>

          <p style="color: var(--text-secondary); font-size: 0.84375rem; margin-bottom: 1rem; line-height: 1.5;">
            {week.summary}
          </p>

          <div style="background: var(--bg-subtle); border-radius: var(--radius-xs); padding: 0.85rem; border: 1px solid var(--border-subtle); margin-bottom: 1rem;">
            <div style="font-size: 0.6875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.4rem;">
              Key Learning Objectives:
            </div>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.3rem;">
              {week.objectives.map((obj, i) => (
                <li style="display: flex; align-items: baseline; gap: 0.5rem; font-size: 0.8125rem; color: var(--text-secondary);">
                  <span style="color: var(--text-muted); font-weight: 600; font-family: var(--font-mono); font-size: 0.75rem;">{i+1}.</span>
                  <span>{obj}</span>
                </li>
              ))}
            </ul>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem; font-size: 0.78125rem;">
            <div>
              <span style="color: var(--text-muted);">Required Deliverable: </span>
              <span style="color: var(--text-primary); font-weight: 500;">{week.deliverable}</span>
            </div>
            {week.week === 2 && (
              <span class="badge badge-warning">
                Active Sprint
              </span>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Locked Weeks Notice & Control Pointer -->
    {weeksData.length > visibleWeeksData.length && (
      <div class="card" style="padding: 1.5rem; border-style: dashed; background: var(--bg-subtle); text-align: center; margin-bottom: 3rem;">
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
          <span class="badge badge-neutral" style="font-size: 0.65rem;">LOCKED IN CONFIG</span>
          <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">Weeks {visibleWeeksData.length + 1}–{weeksData.length} & Months 2–3 Hidden</span>
        </div>
        <h3 style="font-size: 0.9375rem; font-weight: 500; color: var(--text-secondary); margin-bottom: 0.35rem;">
          Later milestones unlock as the internship advances
        </h3>
        <p style="font-size: 0.8125rem; color: var(--text-muted); max-width: 600px; margin: 0 auto 1rem; line-height: 1.45;">
          You control visibility via <code class="code-pill">roadmapConfig</code> in <code class="code-pill">src/data/internshipData.js</code> or manage it directly in the Data Manager portal.
        </p>
        <a href="/data-manager" class="btn btn-secondary btn-sm">
          <span>Manage Visibility Config</span>
          &rarr;
        </a>
      </div>
    )}
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const store = window.InternshipStore;
      const weeksContainer = document.getElementById('weeks-container');
      const filterBtns = document.querySelectorAll('.filter-btn');
      const searchInput = document.getElementById('milestone-search');

      let currentFilter = 'all';
      let searchQuery = '';

      function getWeeksData() {
        if (store) {
          return store.getVisibleWeeks ? store.getVisibleWeeks() : store.getWeeks();
        }
        return [];
      }

      function renderCard(week) {
        const borderStyle = week.status === 'Completed' ? 'var(--accent-emerald)' : week.status === 'In Progress' ? 'var(--accent-amber)' : 'var(--border-subtle)';
        const badgeStyle = week.status === 'Completed' ? 'badge-success' : week.status === 'In Progress' ? 'badge-warning' : 'badge-neutral';
        const objectivesHtml = (week.objectives || []).map((obj, i) => `
          <li style="display: flex; align-items: baseline; gap: 0.5rem; font-size: 0.8125rem; color: var(--text-secondary);">
            <span style="color: var(--text-muted); font-weight: 600; font-family: var(--font-mono); font-size: 0.75rem;">${i+1}.</span>
            <span>${obj}</span>
          </li>
        `).join('');

        return `
          <div
            class="card week-card"
            data-month="month-${week.month}"
            data-status="${week.status.toLowerCase().replace(' ', '-')}"
            data-text="${(week.title + ' ' + week.summary + ' ' + (week.objectives||[]).join(' ')).toLowerCase()}"
            style="padding: 1.5rem; border-left: 3px solid ${borderStyle}; margin-bottom: 1rem;"
          >
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.75rem;">
              <div>
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                  <span class="badge badge-neutral" style="font-family: var(--font-mono); font-size: 0.65rem;">WEEK ${week.week}</span>
                  <span class="badge badge-neutral" style="font-size: 0.65rem;">MONTH ${week.month}</span>
                  <span class="badge ${badgeStyle}">${week.status}</span>
                  <span style="color: var(--text-muted); font-size: 0.75rem; font-family: var(--font-mono);">${week.period || ''}</span>
                </div>
                <h2 style="font-size: 1.125rem; font-weight: 600; color: var(--text-primary);">${week.title}</h2>
              </div>
              <div style="display: flex; gap: 0.375rem; align-items: center; flex-wrap: wrap;">
                <a href="/data-manager" class="btn btn-outline btn-sm" title="Edit this milestone">Edit</a>
                ${week.hasDetailPlan ? `<a href="/milestones/${week.planSlug}" class="btn btn-primary btn-sm">Plan &rarr;</a>` : ''}
                ${week.week === 1 ? `<a href="/reports/week-1" class="btn btn-secondary btn-sm">Report #1</a>` : `<a href="/reports/new?week=${week.week}" class="btn btn-secondary btn-sm">Report</a>`}
              </div>
            </div>

            <p style="color: var(--text-secondary); font-size: 0.84375rem; margin-bottom: 1rem; line-height: 1.5;">${week.summary || ''}</p>

            <div style="background: var(--bg-subtle); border-radius: var(--radius-xs); padding: 0.85rem; border: 1px solid var(--border-subtle); margin-bottom: 1rem;">
              <div style="font-size: 0.6875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.4rem;">
                Key Learning Objectives:
              </div>
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.3rem;">
                ${objectivesHtml}
              </ul>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem; font-size: 0.78125rem;">
              <div>
                <span style="color: var(--text-muted);">Required Deliverable: </span>
                <span style="color: var(--text-primary); font-weight: 500;">${week.deliverable || 'Weekly Report'}</span>
              </div>
              ${week.week === 2 ? `<span class="badge badge-warning">Active Sprint</span>` : ''}
            </div>
          </div>
        `;
      }

      function applyFilters() {
        const cards = document.querySelectorAll('.week-card');
        cards.forEach(card => {
          const cardMonth = card.getAttribute('data-month');
          const cardText = card.getAttribute('data-text') || '';

          const matchesFilter = (currentFilter === 'all') || (cardMonth === currentFilter);
          const matchesSearch = !searchQuery || cardText.includes(searchQuery);

          card.style.display = (matchesFilter && matchesSearch) ? 'block' : 'none';
        });
      }

      // Initial check if store has custom visible data
      const storedWeeks = getWeeksData();
      if (storedWeeks && storedWeeks.length > 0) {
        weeksContainer.innerHTML = storedWeeks.map(renderCard).join('');
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('btn-primary', 'active');
            b.classList.add('btn-secondary');
          });
          btn.classList.remove('btn-secondary');
          btn.classList.add('btn-primary', 'active');
          currentFilter = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.toLowerCase().trim();
          applyFilters();
        });
      }

      // Listen for data updates
      window.addEventListener('internship-data-changed', () => {
        const updated = getWeeksData();
        if (updated && updated.length > 0) {
          weeksContainer.innerHTML = updated.map(renderCard).join('');
          applyFilters();
        }
      });
    });
  </script>
</Layout>
