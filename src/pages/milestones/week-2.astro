            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; margin-bottom: 1.25rem;">
              {pillar.flowSteps.map((step) => (
                <div style="background: var(--bg-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.75rem;">
                  <strong style="color: var(--text-primary); font-size: 0.8125rem; display: block; margin-bottom: 0.25rem;">{step.step}</strong>
                  <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4;">{step.detail}</p>
                </div>
              ))}
            </div>
          )}

          <!-- Specific Content for Pillar 3 (RBAC Matrix) -->
          {pillar.roles && (
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; margin-bottom: 1.25rem;">
              {pillar.roles.map((r) => (
                <div style="background: var(--bg-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.75rem;">
                  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.25rem;">
                    <strong style="color: var(--text-primary); font-size: 0.8125rem;">{r.role}</strong>
                    <span class="badge badge-neutral" style="font-size: 0.625rem;">RBAC</span>
                  </div>
                  <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4;">{r.perm}</p>
                </div>
              ))}
            </div>
          )}

          <!-- Specific Content for Pillar 5 (Configs) -->
          {pillar.configs && (
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.75rem; margin-bottom: 1.25rem;">
              {pillar.configs.map((cfg) => (
                <div style="background: var(--bg-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.75rem;">
                  <code class="code-pill" style="font-weight: 600; margin-bottom: 0.25rem; display: inline-block;">{cfg.file}</code>
                  <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.25rem; line-height: 1.4;">{cfg.purpose}</p>
                </div>
              ))}
            </div>
          )}

          <!-- Actionable Checklist -->
          <div style="border-top: 1px solid var(--border-subtle); padding-top: 1rem;">
            <div style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.5rem;">
              Required Action Items:
            </div>
            {pillar.checklist.map((item, idx) => (
              <div class="checklist-item" data-task-id={`pillar-${pillar.id}-task-${idx}`}>
                <div class="custom-checkbox"></div>
                <div class="checklist-text" style="font-size: 0.8125rem; color: var(--text-primary);">{item}</div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- INTERNAL DEPENDENCIES: Dependencies Project Deep Dive -->
    <section id="dependencies" class="dependencies-section" style="margin-bottom: 2.5rem;">
      <div class="dependencies-header" style="margin-bottom: 1rem;">
        <span class="badge badge-neutral">INTERNAL DEPENDENCIES</span>
        <h2 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-top: 0.35rem;">
          Dependencies Project Deep Dive
        </h2>
        <p style="color: var(--text-secondary); font-size: 0.8125rem;">
          Rationale, usage points, and runtime execution of internal shared libraries.
        </p>
      </div>

      <div class="dependencies-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1rem;">
        <!-- httputils Card -->
        <div class="card" style="padding: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
            <div>
              <span class="badge badge-neutral" style="margin-bottom: 0.25rem;">HTTP Client</span>
              <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-primary);">{dependencyDetails.httputils.name}</h3>
              <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">
                {dependencyDetails.httputils.groupId}:{dependencyDetails.httputils.name}
              </span>
            </div>
            <span class="code-pill">Java 1.8 / 17</span>
          </div>

          <div style="margin-bottom: 1rem;">
            <strong style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 0.2rem;">Why is it needed?</strong>
            <p style="font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.45;">{dependencyDetails.httputils.whyNeeded}</p>
          </div>

          <div style="margin-bottom: 1rem;">
            <strong style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 0.2rem;">Where is it used?</strong>
            <p style="font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.45;">{dependencyDetails.httputils.whereUsed}</p>
          </div>

          <div style="background: var(--bg-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.75rem;">
            <strong style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 0.2rem;">How it works behind the scenes</strong>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.45;">{dependencyDetails.httputils.howItWorks}</p>
          </div>
        </div>

        <!-- sequelize-java Card -->
        <div class="card" style="padding: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
            <div>
              <span class="badge badge-neutral" style="margin-bottom: 0.25rem;">Custom ORM</span>
              <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-primary);">{dependencyDetails.sequelizeJava.name}</h3>
              <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">
                {dependencyDetails.sequelizeJava.groupId}:{dependencyDetails.sequelizeJava.name}
              </span>
            </div>
            <span class="code-pill">Postgres / MSSQL</span>
          </div>

          <div style="margin-bottom: 1rem;">
            <strong style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 0.2rem;">Why is it needed?</strong>
            <p style="font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.45;">{dependencyDetails.sequelizeJava.whyNeeded}</p>
          </div>

          <div style="margin-bottom: 1rem;">
            <strong style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 0.2rem;">Where is it used?</strong>
            <p style="font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.45;">{dependencyDetails.sequelizeJava.whereUsed}</p>
          </div>

          <div style="background: var(--bg-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.75rem;">
            <strong style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 0.2rem;">How it works behind the scenes</strong>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.45;">{dependencyDetails.sequelizeJava.howItWorks}</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>
    @media print {
      #dependencies, .dependencies-section {
        break-before: page !important;
        page-break-before: always !important;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
        margin-top: 0 !important;
        padding-top: 0.5rem !important;
      }
      .dependencies-header {
        break-after: avoid !important;
        page-break-after: avoid !important;
        margin-bottom: 0.5rem !important;
      }
      .dependencies-grid {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 0.75rem !important;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
      }
      .dependencies-grid .card {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
        padding: 0.85rem !important;
        font-size: 0.75rem !important;
        margin-bottom: 0 !important;
      }
      .dependencies-grid p {
        font-size: 0.71875rem !important;
        line-height: 1.35 !important;
        margin-bottom: 0.35rem !important;
      }
      section[id^="pillar-"] {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
        margin-bottom: 1rem !important;
      }
      .checklist-item {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
      }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const items = document.querySelectorAll('.checklist-item');
      items.forEach((item) => {
        const taskId = item.getAttribute('data-task-id');
        if (taskId && localStorage.getItem(`task_${taskId}`) === 'true') {
          item.classList.add('checked');
        }

        item.addEventListener('click', () => {
          const willBeChecked = !item.classList.contains('checked');
          item.classList.toggle('checked', willBeChecked);
          if (taskId) {
            localStorage.setItem(`task_${taskId}`, willBeChecked);
          }
        });
      });
    });
  </script>
</Layout>
