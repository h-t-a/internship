---
import Layout from '../../layouts/Layout.astro';
import { dependencyDetails, programArtifacts } from '../../data/internshipData.js';

const pillars = [
  {
    id: 1,
    title: "1. Portal Architecture: Understand the differences between iBanking_portal and adminconsole",
    tag: "Portal Architecture",
    desc: "Analyze the core differences in user personas, operational scope, state management, and deployment between retail banking and back-office administrative portals.",
    comparison: [
      { feature: "Target Audience", ibanking: "Retail & SME Bank Customers", admin: "Bank Operations, Risk Officers, System Admins" },
      { feature: "Primary Tech", ibanking: "Angular 17+ Customer SPA", admin: "Angular SPA (admin_console_spa) + Nginx" },
      { feature: "Security Stance", ibanking: "Self-service, OTP, Session timeout", admin: "Strict RBAC, Maker-Checker, Immutable Audit Log" },
      { feature: "Data Operations", ibanking: "Account balances, fund transfers, bill pay", admin: "User management, limit overrides, audit trail inspection" }
    ],
    checklist: [
      "Review Angular directory hierarchy in admin_console_spa vs ibanking17",
      "Inspect nginx.conf and Dockerfile deployment setups for both portals",
      "Analyze routing, component lazy loading, and state services in Admin Console"
    ]
  },
  {
    id: 2,
    title: "2. Customer Authentication: Study OTP verification, JWT access tokens and refresh tokens",
    tag: "Customer Authentication",
    desc: "Examine end-to-end customer authentication: credential validation, SMS/Email OTP challenge, JWT access token issuance, and silent refresh token rotation.",
    flowSteps: [
      { step: "1. Login Request", detail: "Customer submits credentials; backend validates against customer DB schema." },
      { step: "2. OTP Challenge", detail: "6-digit short-lived OTP generated, salted & stored with TTL; sent via SMS gateway." },
      { step: "3. JWT Issuance", detail: "On OTP match, server issues short-lived JWT Access Token (15m) and secure Refresh Token." },
      { step: "4. Token Rotation", detail: "Angular HTTP Interceptor refreshes Access Token automatically before expiry." }
    ],
    checklist: [
      "Trace OTP generation, validation, and expiry timeout handling in backend",
      "Inspect JWT payload claims (sub, exp, iss, customerId, permissions)",
      "Verify refresh token storage in secure HTTP-only cookies vs memory storage"
    ]
  },
  {
    id: 3,
    title: "3. Admin Authentication: Understand RBAC, roles, permissions and session management",
    tag: "Admin Authentication",
    desc: "Examine how back-office administrative users are authenticated and governed using granular Role-Based Access Control (RBAC).",
    roles: [
      { role: "Super Admin", perm: "Full tenant administration, system settings, role provisioning" },
      { role: "Checker / Approver", perm: "Review and approve/reject maker transactions and customer status overrides" },
      { role: "Maker / Operator", perm: "Initiate administrative adjustments, initiate customer unlocks" },
      { role: "Auditor / Compliance", perm: "Read-only access to immutable audit trails, system access logs" }
    ],
    checklist: [
      "Inspect Role, Permission, and AdminUser tables in PostgreSQL schema",
      "Trace API authorization filters checking required permissions on incoming requests",
      "Examine admin session idle timeout mechanisms (10-15 minute threshold)"
    ]
  },
  {
    id: 4,
    title: "4. API Gateway: Learn API routing, authentication policies and request handling",
    tag: "API Gateway",
    desc: "Study how API requests enter through an API Gateway, get evaluated against global policies (CORS, Rate Limiting, Token Verification), and proxy downstream.",
    checklist: [
      "Review gateway URL rewrite rules routing /api/admin/* and /api/customer/*",
      "Analyze rate-limiting and IP allowlisting policies applied to back-office routes",
      "Track header propagation (X-Correlation-ID, X-User-ID) for end-to-end tracing"
    ]
  },
  {
    id: 5,
    title: "5. Serverless Services: Understand communication between Azure Functions and backend services",
    tag: "Serverless Services",
    desc: "Understand serverless execution in the admin_console backend, reviewing host.json, local.settings.json, and Azure Functions runtime triggers.",
    configs: [
      { file: "host.json", purpose: "Specifies runtime logging levels, extension bundles, and function timeout policies." },
      { file: "local.settings.json", purpose: "Local environment secrets, DB connection strings, and Azure storage connection." },
      { file: "pom.xml", purpose: "Includes azure-functions-java-library and azure-functions-maven-plugin packaging." }
    ],
    checklist: [
      "Inspect host.json and local.settings.json in admin_console",
      "Run Azure Functions locally using 'mvn azure-functions:run'",
      "Examine communication channels between HTTP-triggered functions and backend DB"
    ]
  },
  {
    id: 6,
    title: "6. Security & Testing: Review authorization, error handling, logging and audit trails",
    tag: "Security & Testing",
    desc: "Audit trails are non-negotiable in financial systems. Learn how audit logs record 'Who, What, When, IP, Before/After State' for every mutation.",
    checklist: [
      "Review audit log schema in PostgreSQL (cleandb.sql / report.sql)",
      "Verify centralized error handling preventing stack trace leakage to clients",
      "Analyze sensitive data masking (sanitizing passwords, tokens, and PII from log output)"
    ]
  },
  {
    id: 7,
    title: "7. Documentation: Prepare an architecture diagram and summarize key findings",
    tag: "Documentation",
    desc: "Produce technical architecture artifacts, sequence diagrams, and key findings to present to mentors and engineering leadership.",
    checklist: [
      "Draft system architecture diagram illustrating client SPAs, Gateway, Functions, and DB",
      "Document key security differences between customer portal and admin console",
      "Compile Week 2 findings into executive report for manager review"
    ]
  }
];
---

