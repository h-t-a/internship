      <!-- Sprint Meta Footer -->
      <div style="margin-top: 1rem; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; font-size: 0.75rem;">
        <div style="display: flex; gap: 0.75rem; color: var(--text-muted); flex-wrap: wrap;">
          <span><strong>Lead Mentor:</strong> Ko Hlwan Kyaw Phyo</span>
          <span>&bull;</span>
          <span><strong>Interns:</strong> Ma Yamin Aye &amp; Mg Phyo Min Htet</span>
          <span>&bull;</span>
          <span><strong>Deliverable:</strong> Weekly Report #2 + Architecture Diagram</span>
        </div>
        <div style="color: var(--text-secondary); font-family: var(--font-mono);">
          Source: milestones/week_2/plan.md
        </div>
      </div>
    </div>

    <!-- Repository Reference Bar -->
    <div class="card" style="padding: 0.75rem 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
      <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; font-size: 0.75rem; color: var(--text-muted);">
