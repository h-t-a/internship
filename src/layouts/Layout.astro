---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "MFS Digital Banking | Internship 2026 Portal",
  description = "Project planning, monitoring, weekly reports and architecture portal for the MFS Digital Banking Internship 2026.",
  currentPath = ""
} = Astro.props;

const navItems = [
  { href: "/", label: "Dashboard", badge: null },
  { href: "/milestones", label: "Milestones", badge: null },
  { 
    href: "/milestones/week-2", 
    label: "Week 2 Sprint", 
    badge: "Active",
    hasDropdown: true,
    subItems: [
      { href: "/milestones/week-2", label: "Overview & Objectives", desc: "Dual-portal overview & 8 pillars" },
      { href: "/milestones/week-2/checklists", label: "Checklists Hub (Pillars 1–8)", desc: "Interactive checklists & sequence diagrams" },
      { href: "/milestones/week-2/pillar-2", label: "Pillar 2: Auth Deep Dive", desc: "OTP, JWT, RSA & Admin IAM blueprint" },
      { href: "/milestones/week-2/checklists#mentor-rubric", label: "Mentor Marking Rubric", desc: "100-point practice project scorecard", highlight: true },
    ]
  },
  { href: "/reports", label: "Reports", badge: null },
  { href: "/architecture", label: "Architecture & Libs", badge: null },
  { href: "/manager-review", label: "Manager Portal", badge: "Review" },
  { href: "/data-manager", label: "Data Manager", badge: null }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏦</text></svg>" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfcfc" />
    <script is:inline src="/scripts/dataStore.js"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-badge" title="MFS Digital Banking Internship Portal">
          <span class="brand-wordmark">MFS</span>
        </a>

        <nav class="site-nav" aria-label="Main Navigation">
          <ul class="nav-links">
            {navItems.map((item) => (
              item.hasDropdown ? (
                <li class="nav-item-dropdown">
                  <a
                    href={item.href}
                    class={`nav-link dropdown-toggle ${currentPath.startsWith('/milestones/week-2') ? 'active' : ''}`}
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    <span>{item.label}</span>
                    {item.badge && (
                      <span class="badge badge-warning" style="padding: 0.05rem 0.35rem; font-size: 0.65rem;">
                        {item.badge}
                      </span>
                    )}
                    <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left: 0.15rem; transition: transform 0.15s ease;">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </a>
                  <div class="dropdown-panel">
                    <div class="dropdown-header">Week 2 Architecture &amp; Deliverables</div>
                    {item.subItems.map((sub) => (
                      <a href={sub.href} class={`dropdown-item ${sub.highlight ? 'dropdown-item-highlight' : ''}`}>
                        <span class="dropdown-item-title">{sub.label}</span>
                        <span class="dropdown-item-desc">{sub.desc}</span>
                      </a>
                    ))}
                  </div>
                </li>
              ) : (
                <li>
                  <a
                    href={item.href}
                    class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
                  >
                    <span>{item.label}</span>
                    {item.badge && (
                      <span class="badge badge-neutral" style="padding: 0.05rem 0.35rem; font-size: 0.65rem;">
                        {item.badge}
                      </span>
                    )}
                  </a>
                </li>
              )
            ))}
          </ul>
        </nav>

        <div class="header-actions">
          <a href="/reports/new" class="btn btn-primary btn-sm no-print" title="Submit Weekly Progress Report">
            <span>+ Report</span>
          </a>
          <button onclick="window.print()" class="btn btn-secondary btn-sm no-print" title="Print this view or Save as PDF for Manager">
            <span>PDF</span>
          </button>
          <button id="mobile-nav-toggle" class="btn btn-secondary btn-sm mobile-toggle no-print" aria-label="Toggle Navigation Menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobile-nav-drawer" class="mobile-nav-drawer">
        <div class="mobile-nav-inner">
          <a href="/" class={`mobile-nav-link ${currentPath === '/' ? 'active' : ''}`}>Dashboard</a>
          <a href="/milestones" class={`mobile-nav-link ${currentPath === '/milestones' ? 'active' : ''}`}>Milestones Roadmap</a>
          
          <div class="mobile-nav-group">
            <div class="mobile-nav-group-title">Week 2 Sprint</div>
            <a href="/milestones/week-2" class="mobile-nav-sublink">Overview &amp; Objectives</a>
            <a href="/milestones/week-2/checklists" class="mobile-nav-sublink">Checklists Hub (Pillars 1–8)</a>
            <a href="/milestones/week-2/pillar-2" class="mobile-nav-sublink">Pillar 2: Auth Deep Dive</a>
            <a href="/milestones/week-2/checklists#mentor-rubric" class="mobile-nav-sublink" style="color: var(--accent-orange, #f59e0b); font-weight: 600;">Mentor Marking Rubric</a>
          </div>

          <a href="/reports" class={`mobile-nav-link ${currentPath === '/reports' ? 'active' : ''}`}>Weekly Reports</a>
          <a href="/reports/new" class={`mobile-nav-link ${currentPath === '/reports/new' ? 'active' : ''}`}>+ Submit New Report</a>
          <a href="/architecture" class={`mobile-nav-link ${currentPath === '/architecture' ? 'active' : ''}`}>Architecture &amp; Libraries</a>
          <a href="/manager-review" class={`mobile-nav-link ${currentPath === '/manager-review' ? 'active' : ''}`}>
            <span>Manager Portal (Sign-Off)</span>
            <span class="badge badge-warning" style="font-size: 0.65rem;">Review</span>
          </a>
          <a href="/data-manager" class={`mobile-nav-link ${currentPath === '/data-manager' ? 'active' : ''}`}>Data Manager</a>
        </div>
      </div>
    </header>

    <main style="flex: 1; padding: 2rem 0 4rem;">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <span style="color: var(--text-primary); font-weight: 600; font-size: 0.8125rem;">Software Development Department (SDD)</span>
          <span style="color: var(--text-muted); margin: 0 0.5rem;">•</span>
          <span style="color: var(--text-secondary); font-size: 0.75rem;">Digital Banking Dual-Portal Architecture</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <span class="badge badge-success" style="font-size: 0.7rem;">
            Azure Static Web Ready
          </span>
          <a href="/manager-review" class="nav-link" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
            Manager Portal &rarr;
          </a>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('mobile-nav-toggle');
        const drawer = document.getElementById('mobile-nav-drawer');

        if (toggleBtn && drawer) {
          toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            drawer.classList.toggle('open');
          });

          // Close on click outside
          document.addEventListener('click', (e) => {
            if (!drawer.contains(e.target) && !toggleBtn.contains(e.target)) {
              drawer.classList.remove('open');
            }
          });
        }
      });
    </script>
  </body>
</html>
